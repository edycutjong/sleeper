{
  "name": "sleeper",
  "version": "1.0.0",
  "private": true,
  "description": "A release-gate agent whose multi-year memory of every commit, email and maintainer change recognises a slow-motion supply-chain takeover and atomically holds the poisoned release.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "schema": "tsx scripts/schema.ts",
    "seed": "tsx scripts/seed.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "replay": "tsx scripts/replay.ts",
    "explain": "tsx scripts/explain.ts",
    "notice": "tsx scripts/notice.ts",
    "unhold": "tsx scripts/unhold.ts",
    "mcp:audit": "tsx scripts/mcp-audit.ts",
    "provision": "./scripts/provision.sh",
    "bench": "tsx scripts/bench.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "counts": "tsx scripts/counts.ts",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1110.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
