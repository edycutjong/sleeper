.env
.env.*
# ... except the template, which is the example config the setup instructions tell you to copy.
!.env.example

# Fitted at setup time by `npm run calibrate` against whichever embedding model is configured.
# Never committed: a thresholds file from someone else's model would silently change the gate.
data/thresholds.json
node_modules/
__pycache__/
.next/
dist/
coverage/
.DS_Store

# Deploy artifacts from scripts/deploy-aws.sh. The zip embeds data/, and the staging tree is
# rebuilt from source on every run, so neither is worth versioning.
.aws-build/
function.zip
.vercel/
