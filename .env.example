# Copy to .env and fill in. .env is gitignored — never commit real values.

# From: ./scripts/provision.sh   (or: ccloud cluster sql --connection-url sleeper-cluster)
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# ── CockroachDB Cloud Managed MCP Server (https://cockroachlabs.cloud/mcp) ──────────────
# OPTIONAL. Both blank = the audit path (`npm run explain`, holdEvidence) runs over direct SQL
# and says so on every run. Set them and the same reads go over MCP instead:
# get_table_schema / explain_query / select_query / show_statement — read-only at the protocol
# layer, audit-logged by CockroachDB. The write path (ingest, the atomic HOLD) never uses MCP:
# the server takes ONE statement per call and cannot express a four-write transaction.
#
# Service-account API key -> `Authorization: Bearer ...`
# Create with: ./scripts/provision.sh --mcp-key    (prints the key once; it is never stored here)
COCKROACH_MCP_API_KEY=

# Pins the MCP session to ONE cluster -> `mcp-cluster-id: ...` header. Without it the key can
# reach every cluster the service account's role covers. Id from the Cloud console URL:
#   https://cockroachlabs.cloud/cluster/{THIS_PART}/overview
COCKROACH_CLUSTER_ID=

# Overrides the endpoint (self-hosted MCP server, or a staging environment). Rarely needed.
# COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp

# Set to `off` to force the direct-SQL fallback with the credentials still in place — used to
# show both audit paths back to back in the demo.
# SLEEPER_MCP=off

# Bedrock must be enabled in this region AND the two models below must be granted
# model access in the Bedrock console before any of this works.
AWS_REGION=us-east-1

# Titan Text Embeddings V2 — 1024-dim output, matching VECTOR(1024) in sql/schema.sql.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Claude on Bedrock, used through the Converse API.
# VERIFY THIS ID against your account before relying on it:
#   aws bedrock list-inference-profiles --region "$AWS_REGION"
# Cross-region inference profiles are prefixed by geography (us. / eu. / apac.) and the
# available Claude models differ by account and region.
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

PACKAGE_ID=xz-utils
ARC_WINDOW_DAYS=90

# ── Everything below is optional; the defaults are the ones we run. ─────────────────────

# The demo server binds loopback only. Change this and it is reachable from your network —
# `/api/replay` wipes the package's memory, so only widen it deliberately. A non-loopback
# value prints a warning at startup.
# SLEEPER_BIND_HOST=127.0.0.1

# Structured JSON logs go to stderr, one line per event, correlated by `corrId`. `off` silences
# them; nothing else in the process writes to stderr, so `off` means silence.
# SLEEPER_LOG=off

# Bedrock resilience. Retries cover throttling and 5xx with full-jitter backoff; a validation
# error fails fast rather than burning the budget.
# BEDROCK_MAX_ATTEMPTS=4
# BEDROCK_CONNECT_TIMEOUT_MS=5000
# BEDROCK_REQUEST_TIMEOUT_MS=60000

# How much of an actor's history reaches the model. The 90-day window above bounds TIME, not
# COUNT — a busy package can put thousands of events inside it. When the cap bites, the prompt
# says so and carries the true total, so the model is never misled about tenure.
# ARC_MAX_PROMPT_EVENTS=120
# ARC_MAX_EVENT_CHARS=600

# Inbound webhook fields are REJECTED, not truncated, when over length: the stored row is the
# evidence a hold is later justified by, and silently shortening it would corrupt that record.
# MAX_EVENT_CONTENT_CHARS=8192

# Upper bound on rows returned by the two history reads. Truncation drops the OLDEST events and
# is reported in the logs.
# SLEEPER_HISTORY_LIMIT=5000
